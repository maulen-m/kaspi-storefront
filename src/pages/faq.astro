---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout title="FAQ — ACMEWEAR" description="Частые вопросы ACMEWEAR.">
  <div class="container">
    <div class="section__head" style="margin-top:0;">
      <div>
        <h1 class="section__title" style="font-size: var(--step-3); margin:0;">FAQ</h1>
        <p class="section__sub" style="margin-top:8px;">Ответы на основные вопросы.</p>
      </div>
    </div>

    <div class="grid">
      <article class="card" style="grid-column: span 6;">
        <div class="card__pad">
          <h3 class="card__title">Как купить?</h3>
          <p class="card__text">Выберите товар и перейдите в Kaspi через кнопку на сайте.</p>
        </div>
      </article>
      <article class="card" style="grid-column: span 6;">
        <div class="card__pad">
          <h3 class="card__title">Где заказать доставку?</h3>
          <p class="card__text">Доставка оформляется через Kaspi. Подробности уточняются.</p>
        </div>
      </article>
      <article class="card" style="grid-column: span 6;">
        <div class="card__pad">
          <h3 class="card__title">Как связаться?</h3>
          <p class="card__text">WhatsApp и телефон доступны в разделе Контакты.</p>
        </div>
      </article>
    </div>
  </div>
</BaseLayout>
