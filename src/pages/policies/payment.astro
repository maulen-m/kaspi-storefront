---
import BaseLayout from "../../layouts/BaseLayout.astro";
---

<BaseLayout title="Оплата — ACMEWEAR" description="Информация об оплате ACMEWEAR.">
  <div class="container">
    <div class="section__head" style="margin-top:0;">
      <div>
        <h1 class="section__title" style="font-size: var(--step-3); margin:0;">Оплата</h1>
        <p class="section__sub" style="margin-top:8px;">
          Основной канал — Kaspi. Карта добавится позже.
        </p>
      </div>
    </div>

    <div class="panel">
      <p class="card__text">Оплата осуществляется через Kaspi. Подробности будут обновлены.</p>
    </div>
  </div>
</BaseLayout>
