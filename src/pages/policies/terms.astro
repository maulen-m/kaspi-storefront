---
import BaseLayout from "../../layouts/BaseLayout.astro";
---

<BaseLayout
  title="Пользовательское соглашение — ACMEWEAR"
  description="Условия использования сайта ACMEWEAR."
>
  <div class="container">
    <div class="section__head" style="margin-top:0;">
      <div>
        <h1 class="section__title" style="font-size: var(--step-3); margin:0;">
          Пользовательское соглашение
        </h1>
        <p class="section__sub" style="margin-top:8px;">
          Шаблонный текст — заменить перед запуском.
        </p>
      </div>
    </div>

    <div class="panel">
      <p class="card__text">Добавьте юридические условия использования сайта и товаров.</p>
    </div>
  </div>
</BaseLayout>
