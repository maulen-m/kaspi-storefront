---
import { getCollection } from "astro:content";
import LandingLayout from "../../layouts/LandingLayout.astro";
import CountdownFlip from "../../components/CountdownFlip.astro";
import { getProductBySlug } from "../../lib/products";
import { formatKZT } from "../../lib/format";

export async function getStaticPaths() {
  const landers = await getCollection("landers");
  return landers.map((entry) => ({
    params: { campaign: entry.id },
  }));
}

const landers = await getCollection("landers");
const { campaign } = Astro.params;
const entry = landers.find((item) => item.id === campaign);

if (!entry) {
  return Astro.redirect("/shop");
}

const lander = entry.data;
const utmParams = new URLSearchParams();
if (lander.utm) {
  Object.entries(lander.utm).forEach(([key, value]) => {
    if (value) utmParams.set(key, value);
  });
}

const buildKaspiHref = (slug: string) => {
  const qs = utmParams.toString();
  return qs ? `/go/kaspi/${slug}?${qs}` : `/go/kaspi/${slug}`;
};

const featured = (lander.featured_products ?? [])
  .map((slug) => getProductBySlug(slug))
  .filter((item): item is NonNullable<ReturnType<typeof getProductBySlug>> => Boolean(item));
const heroProduct = getProductBySlug(lander.hero_product_slug);
const heroImage = lander.hero_image || heroProduct?.images?.[0] || "/assets/img/placeholder.svg";
const bulletItems =
  (heroProduct?.bullets_ru?.length
    ? heroProduct.bullets_ru
    : lander.highlights?.map((item) => item.title)
  )?.slice(0, 3) ?? [];
const ctaSlug = lander.hero_product_slug || lander.primary_cta.kaspi_slug;
const included = featured.slice(0, 3);
const faqItems = [
  {
    q: "Как купить?",
    a: "Нажмите кнопку «Купить в Kaspi» и оформите заказ в приложении Kaspi.",
  },
  {
    q: "Доставка по Казахстану?",
    a: "Оформление и доставка проходят через Kaspi, статус доступен в приложении.",
  },
  {
    q: "Как связаться с поддержкой?",
    a: "Свяжитесь с нами через WhatsApp или по телефону — контакты в шапке.",
  },
];

const analytics =
  featured.length > 0
    ? {
        page_type: "view_item_list",
        item_list_id: `lander:${campaign}`,
        item_list_name: lander.headline,
        items: featured.map((product) => ({
          item_id: product?.id,
          item_name: product?.title_ru,
          item_category: product?.category,
          item_slug: product?.slug,
          price: product?.price_kzt ?? undefined,
        })),
      }
    : null;
---

<LandingLayout title={lander.title} description={lander.description ?? ""} analytics={analytics}>
  <div class="container">
    <section class="cpa-hero">
      <div class="cpa-hero__media">
        <img
          src={heroImage}
          alt={heroProduct?.title_ru ?? lander.headline}
          width="720"
          height="720"
          loading="eager"
          decoding="async"
          fetchpriority="high"
        />
        {
          lander.inventory_left ? (
            <div class="cpa-hero__badge">Осталось {lander.inventory_left} шт.</div>
          ) : null
        }
      </div>
      <div class="cpa-hero__content">
        <div class="kicker">
          <span class="dot"></span>
          {lander.kicker ?? "ACMEWEAR"}
        </div>
        <h1>{lander.headline}</h1>
        {lander.subhead ? <p class="cpa-hero__subhead">{lander.subhead}</p> : null}
        {
          heroProduct?.price_kzt ? (
            <div class="cpa-hero__price">Цена в Kaspi: {formatKZT(heroProduct.price_kzt)}</div>
          ) : null
        }
        {
          bulletItems.length ? (
            <ul class="cpa-hero__bullets">
              {bulletItems.map((item) => (
                <li>{item}</li>
              ))}
            </ul>
          ) : null
        }
        <div class="cpa-hero__cta">
          <a
            class="btn btn--primary"
            href={buildKaspiHref(ctaSlug)}
            data-of-placement={`lander_${campaign}_primary`}
          >
            {lander.primary_cta.label}
          </a>
        </div>
        <div class="cpa-hero__meta">
          <p class="cpa-hero__scarcity">{lander.scarcity_text}</p>
          {
            lander.inventory_left ? (
              <p class="cpa-hero__inventory">Осталось {lander.inventory_left} шт.</p>
            ) : null
          }
          <CountdownFlip
            mode={lander.countdown_mode}
            endIso={lander.countdown_end_iso}
            hours={lander.countdown_hours}
            storageKey={`of_countdown_${campaign}`}
            label="До конца акции"
          />
        </div>
      </div>
    </section>

    {
      included.length ? (
        <section class="section">
          <div class="section__head">
            <div>
              <h2 class="section__title">Что входит</h2>
              <p class="section__sub">Ключевые позиции из комплекта запуска.</p>
            </div>
          </div>
          <div class="grid cpa-includes">
            {included.map((product) => (
              <article class="card cpa-includes__item">
                <div class="card__media">
                  <img
                    src={product.images?.[0] ?? "/assets/img/placeholder.svg"}
                    alt={product.title_ru}
                    loading="lazy"
                  />
                </div>
                <div class="card__pad">
                  <h3 class="card__title">{product.title_ru}</h3>
                  {product.bullets_ru?.[0] ? (
                    <p class="card__text">{product.bullets_ru[0]}</p>
                  ) : null}
                </div>
              </article>
            ))}
          </div>
        </section>
      ) : null
    }

    <section class="section">
      <div class="section__head">
        <div>
          <h2 class="section__title">FAQ</h2>
          <p class="section__sub">Быстрые ответы перед покупкой.</p>
        </div>
      </div>
      <div class="faq">
        {
          faqItems.map((item) => (
            <details class="faq__item">
              <summary class="faq__summary">{item.q}</summary>
              <div class="faq__content">
                <p>{item.a}</p>
              </div>
            </details>
          ))
        }
      </div>
    </section>
  </div>
</LandingLayout>
