---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout title="Размерная сетка — ACMEWEAR" description="Размерная сетка и рекомендации ACMEWEAR.">
  <div class="container">
    <div class="section__head" style="margin-top:0;">
      <div>
        <h1 class="section__title" style="font-size: var(--step-3); margin:0;">Размерная сетка</h1>
        <p class="section__sub" style="margin-top:8px;">Добавьте точные размеры перед запуском.</p>
      </div>
    </div>

    <div class="panel">
      <table class="table" aria-label="Размерная сетка">
        <thead>
          <tr>
            <th>Размер</th>
            <th>Грудь</th>
            <th>Талия</th>
            <th>Бедра</th>
          </tr>
        </thead>
        <tbody>
          <tr>
            <td>S</td>
            <td>—</td>
            <td>—</td>
            <td>—</td>
          </tr>
          <tr>
            <td>M</td>
            <td>—</td>
            <td>—</td>
            <td>—</td>
          </tr>
          <tr>
            <td>L</td>
            <td>—</td>
            <td>—</td>
            <td>—</td>
          </tr>
          <tr>
            <td>XL</td>
            <td>—</td>
            <td>—</td>
            <td>—</td>
          </tr>
        </tbody>
      </table>

      <div class="notice" style="margin-top:16px;">
        <strong>Важно:</strong> замените дефисы на реальные сантиметры.
      </div>
    </div>
  </div>
</BaseLayout>
