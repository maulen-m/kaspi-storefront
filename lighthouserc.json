{
  "ci": {
    "collect": {
      "startServerCommand": "pnpm preview -- --port 4321",
      "startServerReadyPattern": "localhost:4321",
      "url": [
        "http://127.0.0.1:4321/",
        "http://127.0.0.1:4321/shop",
        "http://127.0.0.1:4321/p/performance-training-tee",
        "http://127.0.0.1:4321/l/launch"
      ],
      "numberOfRuns": 1,
      "settings": {
        "preset": "desktop",
        "onlyCategories": ["performance", "seo"],
        "disableStorageReset": true
      }
    },
    "assert": {
      "assertions": {
        "categories:performance": ["error", { "minScore": 0.95 }],
        "categories:seo": ["error", { "minScore": 0.9 }]
      }
    },
    "upload": {
      "target": "temporary-public-storage"
    }
  }
}
